profile coder {
    model: "deepseek-chat"
    max_turns: 4
    tools: ["web_search", "web_fetch"]
}

function prepare_query(user_query; prepared_query) {
    text_concat: {
        left: user_query,
        right: user_query,
        result: prepared_query
    }
}

__start__

string user_query: "What is the weather today?"
string prepared_query
string final_answer

prepare_query: {
    user_query: user_query,
    prepared_query: prepared_query
}

agent: {
    profile: "coder",
    prompt: user_query,
    context: prepared_query,
    response: final_answer
}

__end__
